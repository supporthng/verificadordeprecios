# Configuración del Conector Windows. El instalador la copia a:
#   C:\ProgramData\ConsultaPrecios\bridge.env
# Nunca subir el archivo con valores reales a GitHub.
SUPABASE_URL=https://TU_PROYECTO.supabase.co
# Clave secreta de Supabase: la nueva (sb_secret_...) o la legacy service_role (eyJ...).
SUPABASE_SERVICE_ROLE_KEY=COLOCA_TU_CLAVE_SECRETA

# Contraseña de la pantalla web del conector (mínimo 12 caracteres).
BRIDGE_PASSWORD=CAMBIA_ESTA_CONTRASENA_LARGA

# Dirección y puerto de la pantalla web. No abrir este puerto a Internet.
BRIDGE_HOST=0.0.0.0
BRIDGE_PORT=8765

# Subredes del negocio donde se permite buscar servidores, separadas por comas.
ALLOWED_NETWORKS=192.168.1.0/24

# Dirección de la app Streamlit para volver automáticamente tras el asistente.
# STREAMLIT_RETURN_URL=https://TU-APP.streamlit.app/
